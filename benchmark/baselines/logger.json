{
  "schemaVersion": "regression-ci-baseline/v1",
  "suite": "logger",
  "benchmark": {
    "name": "swm-log-core-ci",
    "packageName": "@swarmmachina/swm-logs",
    "packageVersion": "0.1.0",
    "runner": "benchmark/profile-ci.ts",
    "script": "pnpm profile:ci",
    "framework": "swm-log"
  },
  "calibration": {
    "status": "local-calibrated",
    "updatedAt": "2026-07-30",
    "node": "24.17.0",
    "benchkit": "0.2.0",
    "ciRunner": "macOS arm64 local development host",
    "note": "Calibrated from isolated local series. Throughput floors and p99, RSS, and sampled-allocation ceilings include observed jitter. Recalibrate these host-specific bounds before enabling a different dedicated CI runner."
  },
  "parameters": {
    "runs": 3,
    "warmup": 1,
    "connections": 1,
    "pipelining": 1,
    "duration": "operation-bound",
    "destination": "/dev/null",
    "allocationSamplingIntervalBytes": 32768
  },
  "metrics": {
    "operationsPerSecond": { "label": "throughput", "unit": "ops/s" },
    "p99Ms": { "label": "p99", "unit": "ms" },
    "rssPeakMiB": { "label": "RSS peak", "unit": "MiB" },
    "allocationBytesPerOperation": { "label": "sampled allocation", "unit": "B/op" }
  },
