  "calibration": {
    "status": "ci-runner-calibrated",
    "updatedAt": "2026-08-01",
    "node": "24.16.0",
    "benchkit": "0.2.0",
    "ciRunner": "dedicated swm-ci Linux x64 runner",
    "note": "Throughput and latency guards are calibrated from repeated isolated runs on the dedicated release runner. RSS and sampled-allocation ceilings retain the conservative bounds that passed on that runner. Recalibrate before changing runner hardware."
